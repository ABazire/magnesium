generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(cuid())
  username String  @unique
  currency Int     @default(0)
  diamonds Int @default(0)
  rankPoints3v3 Int @default(1000)
  hasCompletedTutorial Boolean @default(false)
  energy          Int      @default(600)
  energyUpdatedAt DateTime @default(now())
  coupons         Int      @default(10)
  couponsUpdatedAt DateTime @default(now())

  // Connexion quotidienne : jour du dernier passage ("AAAA-MM-JJ") et
  // nombre de jours consécutifs, pour la récompense de streak.
  loginStreak   Int     @default(0)
  lastLoginJour String?

  personnages Personnage[]
  equipments Equipment[]
  spells      Spell[]
  teams       Team[]
  materials   MaterialStack[]
  fragments   PersonnageFragment[]
  quetes      QuestProgress[]

  guilde   Guild?  @relation(fields: [guildeId], references: [id])
  guildeId String?
  guildeBossContributions GuildBossContribution[]
}

model Guild {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  leaderId  String

  membres User[]
  boss    GuildBoss?
}

// Boss coopératif : un seul par guilde, avec une réserve de vie partagée que
// les membres entament au fil de leurs attaques quotidiennes. "cycle"
// distingue les vies successives du boss (il repop plus costaud après
// chaque défaite) sans perdre l'historique des contributions passées.
model GuildBoss {
  id      String @id @default(cuid())
  guildId String @unique
  guild   Guild  @relation(fields: [guildId], references: [id])

  cycle        Int      @default(1)
  vieMax       Int
  vie          Int
  cycleTermine Boolean  @default(false)
  demarreLe    DateTime @default(now())

  contributions GuildBossContribution[]
}

model GuildBossContribution {
  id     String    @id @default(cuid())
  bossId String
  boss   GuildBoss @relation(fields: [bossId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  cycle              Int
  degats             Int     @default(0)
  attaquesAujourdhui Int     @default(0)
  dernierJour        String?

  @@unique([bossId, userId, cycle])
}

// Progression d'une quête pour un jour donné. La définition de la quête
// (cible, récompense) vit dans le code (src/lib/quetes.ts) : cette table ne
// garde que l'état, pour pouvoir ajuster le catalogue sans migration.
model QuestProgress {
  id      String  @id @default(cuid())
  jour    String // "AAAA-MM-JJ"
  cle     String // identifiant de la définition de quête
  progres Int     @default(0)
  reclame Boolean @default(false)

  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String

  @@unique([ownerId, jour, cle])
}

model Rarity {
  id       String @id @default(cuid())
  stars    Int    @unique
  statMin  Int
  statMax  Int
  dropRate Float

  personnages Personnage[]
  equipments Equipment[]
  spells      Spell[]
}

model Personnage {
  id      String @id @default(cuid())
  name    String

  vie        Int
  force      Int
  vitesse    Int
  resistance Int
  agilite    Int
  mana       Int @default(20)

  level Int @default(1)
  xp    Int @default(0)

  rarity   Rarity? @relation(fields: [rarityId], references: [id])
  rarityId String?

  rankPoints Int @default(500)

  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String

  spriteId Int    @default(0)
  color    String @default("#10b981")

  equipment    PersonnageEquipment[]
  spells       PersonnageSpell[]
  teamMembres  TeamMembre[]
}

enum EquipmentSlot {
  ARME
  ARMURE
  BOTTES
  AMULETTE
}

enum StatType {
  FORCE
  VITESSE
  RESISTANCE
  AGILITE
}

enum SpellType {
  ACTIF
  PASSIF
}

enum SpellEffect {
  DEGATS
  SOIN
  ETOURDISSEMENT
  BONUS_STAT
  REDUCTION_DEGATS

  // Actifs élémentaires
  BRULURE // Feu : dégâts répartis sur plusieurs tours
  DEGATS_ZONE // Foudre : frappe toute l'équipe adverse
  RALENTISSEMENT // Glace : allonge le délai entre deux actions de la cible

  // Passifs
  REGENERATION // Rend des PV à chaque tour
  VOL_DE_VIE // Convertit une part des dégâts infligés en PV
  EPINES // Renvoie une part des dégâts subis
  CRITIQUE // Chance de doubler les dégâts
}

enum SpellElement {
  NEUTRE
  FEU
  GLACE
  FOUDRE
}

enum SpellSlot {
  SORT_1
  SORT_2
  SORT_3
  PASSIF
}

enum EquipmentSet {
  FORCE
  ENDURANCE
  CELERITE
  PRECISION
  REMPART
}

model Equipment {
  id      String        @id @default(cuid())
  name    String
  slot    EquipmentSlot

  bonusStat  StatType
  bonusValue Int

  // Nullable : les objets créés avant l'introduction des sets n'en ont pas,
  // et ne comptent simplement pour aucun bonus d'ensemble.
  ensemble EquipmentSet?
  // Niveau de renforcement (0 à 10), augmente bonusValue à l'usage.
  niveau   Int           @default(0)

  rarity   Rarity @relation(fields: [rarityId], references: [id])
  rarityId String

  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String

  equippedOn PersonnageEquipment?
}

model PersonnageEquipment {
  id String @id @default(cuid())

  personnage   Personnage @relation(fields: [personnageId], references: [id])
  personnageId String

  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  equipmentId String    @unique

  slot EquipmentSlot

  @@unique([personnageId, slot])
}

model Spell {
  id      String       @id @default(cuid())
  name    String
  type    SpellType
  effect  SpellEffect
  element SpellElement @default(NEUTRE)

  // Dégâts : % de dégâts bonus. Soin : PV rendus. Étourdissement : nb de tours sautés.
  // Bonus stat : valeur ajoutée à targetStat. Réduction dégâts : % de dégâts subis en moins.
  // Brûlure : % de dégâts par tour. Zone : % de dégâts sur chaque ennemi.
  // Ralentissement : % de vitesse en moins. Régénération : % PV max par tour.
  // Vol de vie / Épines / Critique : % appliqué à leur effet respectif.
  value Int

  // Nombre de tours pendant lesquels l'effet persiste (brûlure, ralentissement).
  duree Int @default(0)

  targetStat StatType?
  cooldown   Int        @default(3)
  manaCost   Int        @default(10)

  rarity   Rarity @relation(fields: [rarityId], references: [id])
  rarityId String

  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String

  equippedOn PersonnageSpell?
}

model PersonnageSpell {
  id String @id @default(cuid())

  personnage   Personnage @relation(fields: [personnageId], references: [id])
  personnageId String

  spell   Spell  @relation(fields: [spellId], references: [id])
  spellId String @unique

  slot SpellSlot

  @@unique([personnageId, slot])
}

model Team {
  id         String  @id @default(cuid())
  name       String
  estDefense Boolean @default(false)

  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String

  membres TeamMembre[]
}

model TeamMembre {
  id       String @id @default(cuid())
  position Int

  team   Team   @relation(fields: [teamId], references: [id])
  teamId String

  personnage   Personnage @relation(fields: [personnageId], references: [id])
  personnageId String

  @@unique([teamId, position])
  @@unique([teamId, personnageId])
}

enum MaterialType {
  GRIFFE
  CROC
  OS
  CUIR
  ESSENCE_ELEMENTAIRE
  PLUME
  ECAILLE_CRISTAL
}

model MaterialStack {
  id       String       @id @default(cuid())
  type     MaterialType
  quantity Int          @default(0)

  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String

  @@unique([ownerId, type])
}

// Fragments obtenus en renvoyant un personnage : dépensés pour faire monter
// un autre personnage du même palier de rareté au palier supérieur.
model PersonnageFragment {
  id       String @id @default(cuid())
  stars    Int
  quantity Int    @default(0)

  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String

  @@unique([ownerId, stars])
}

// Table orpheline : ancien suivi des limites quotidiennes par monstre,
// remplacé par le système d'énergie. Conservée ici pour ne pas supprimer
// les 131 lignes historiques existantes ; aucun code n'y écrit plus.
model AdventureAttempt {
  id           String   @id @default(cuid())
  playedAt     DateTime @default(now())
  personnageId String
  monsterId    String
  victory      Boolean  @default(false)
}

model Monster {
  id       String @id @default(cuid())
  baseName String @default("") // "Loup" ou "Ours"
  tier     Int @default(1)    // 1 à 5
  name     String @unique // "Loup I", "Loup II", ...

  vie        Int
  force      Int
  vitesse    Int
  resistance Int
  agilite    Int

  gainVictoire Int @default(0)
  gainDefaite  Int @default(0)
  xpGain       Int @default(20)

  @@unique([baseName, tier])
}

model MonsterUnlock {
  id       String @id @default(cuid())
  userId   String
  baseName String
  highestTierUnlocked Int @default(1)

  @@unique([userId, baseName])
}

model Fight {
  id        String   @id @default(cuid())
  playedAt  DateTime @default(now())
  seed      Int
  turns     Json
  winnerId  String
  attackerVieMax Int
  defenderVieMax Int
  attackerManaMax Int @default(0)
  defenderManaMax Int @default(0)

  attackerPersonnageId String
  defenderPersonnageId String
}

model TeamFight {
  id       String   @id @default(cuid())
  playedAt DateTime @default(now())
  seed     Int
  events   Json
  winnerSide String // "A" ou "B"

  attackerUserId String
  defenderUserId String

  fightersA Json // snapshot des 3 combattants du camp A
  fightersB Json // snapshot des 3 combattants du camp B
}