generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(cuid())
  username String  @unique
  currency Int     @default(0)
  rankPoints3v3 Int @default(1000)

  personnages Personnage[]
  equipments Equipment[]
}

model Rarity {
  id       String @id @default(cuid())
  stars    Int    @unique
  statMin  Int
  statMax  Int
  dropRate Float

  personnages Personnage[]
  equipments Equipment[]
}

enum FormationRow {
  AVANT
  ARRIERE
}

model Personnage {
  id      String @id @default(cuid())
  name    String

  vie        Int
  force      Int
  vitesse    Int
  resistance Int
  agilite    Int

  level Int @default(1)
  xp    Int @default(0)

  inTeam Boolean @default(false)

  rarity   Rarity? @relation(fields: [rarityId], references: [id])
  rarityId String?

  rankPoints Int @default(500)

  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String

  formationRow FormationRow @default(AVANT)

  spriteId Int    @default(0)
  color    String @default("#10b981")

  equipment PersonnageEquipment[]
}

enum EquipmentSlot {
  ARME
  ARMURE
  BOTTES
  AMULETTE
}

enum StatType {
  FORCE
  VITESSE
  RESISTANCE
  AGILITE
}

model Equipment {
  id      String        @id @default(cuid())
  name    String
  slot    EquipmentSlot

  bonusStat  StatType
  bonusValue Int

  rarity   Rarity @relation(fields: [rarityId], references: [id])
  rarityId String

  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String

  equippedOn PersonnageEquipment?
}

model PersonnageEquipment {
  id String @id @default(cuid())

  personnage   Personnage @relation(fields: [personnageId], references: [id])
  personnageId String

  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  equipmentId String    @unique

  slot EquipmentSlot

  @@unique([personnageId, slot])
}

model Monster {
  id    String @id @default(cuid())
  name  String @unique

  vie Int
   force      Int
  vitesse    Int
  resistance Int
  agilite    Int
}

model Fight {
  id        String   @id @default(cuid())
  playedAt  DateTime @default(now())
  seed      Int
  turns     Json
  winnerId  String
  attackerVieMax Int
  defenderVieMax Int

  attackerPersonnageId String
  defenderPersonnageId String
}

model TeamFight {
  id       String   @id @default(cuid())
  playedAt DateTime @default(now())
  seed     Int
  events   Json
  winnerSide String // "A" ou "B"

  attackerUserId String
  defenderUserId String

  fightersA Json // snapshot des 3 combattants du camp A
  fightersB Json // snapshot des 3 combattants du camp B
}

model AdventureAttempt {
  id           String   @id @default(cuid())
  playedAt     DateTime @default(now())
  personnageId String
  monsterId    String
}